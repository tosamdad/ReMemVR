{
  "name": "rememvr",
  "private": true,
  "description": "르멤버 화면 스타일 빌드(Tailwind CSS). 결과물은 public/assets/css/ 에 생기며 배포 때 자동으로 만든다.",
  "scripts": {
    "build": "npm run build:user && npm run build:admin",
    "build:user": "tailwindcss -c tailwind.user.config.js -i src/css/user.css -o public/assets/css/user.css --minify",
    "build:admin": "tailwindcss -c tailwind.admin.config.js -i src/css/admin.css -o public/assets/css/admin.css --minify",
    "watch:user": "tailwindcss -c tailwind.user.config.js -i src/css/user.css -o public/assets/css/user.css --watch",
    "watch:admin": "tailwindcss -c tailwind.admin.config.js -i src/css/admin.css -o public/assets/css/admin.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19"
  }
}
